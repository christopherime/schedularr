tunarr:
  url: http://localhost:8000
  api_key: secret

log:
  level: info
  format: text

scheduler:
  blocks:
    - name: "Morning Cartoons"
      cron: "0 6 * * *"
      duration: 240 # 4 hours
      channel_id: "channel-1"
      filter:
        genres: ["Animation", "Family"]
        max_duration: 30
    - name: "Evening Movies"
      cron: "0 20 * * *"
      duration: 180 # 3 hours
      channel_id: "channel-1"
      filter:
        genres: ["Movie"]
        min_duration: 80
