{
  // Editor settings optimized for Go development
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.trimAutoWhitespace": true,
  "editor.renderWhitespace": "boundary",
  "editor.rulers": [
    80,
    120
  ],
  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 120,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit"
  },
  "editor.minimap.enabled": true,
  "editor.minimap.showSlider": "always",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.inlineSuggest.enabled": true,
  "editor.suggestSelection": "first",
  "editor.acceptSuggestionOnCommitCharacter": false,
  // Files settings
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.eol": "\n",
  "files.encoding": "utf8",
  "files.autoSave": "onFocusChange",
  // Go specific settings for Argus project
  "go.useLanguageServer": true,
  "go.formatTool": "goimports",
  "go.lintTool": "golangci-lint",
  "go.lintOnSave": "package",
  "go.lintFlags": [
    "--config=${workspaceFolder}/.golangci.yml",
    "--timeout=5m"
  ],
  "go.vetOnSave": "package",
  "go.testOnSave": false,
  "go.coverOnSave": false,
  "go.coverOnTestPackage": true,
  "go.coverageDecorator": {
    "type": "gutter",
    "coveredHighlightColor": "rgba(64,128,128,0.5)",
    "uncoveredHighlightColor": "rgba(128,64,64,0.25)",
    "coveredGutterStyle": "blockblue",
    "uncoveredGutterStyle": "blockred"
  },
  "go.testFlags": [
    "-v",
    "-race",
    "-count=1"
  ],
  "go.testTimeout": "5m",
  "go.toolsManagement.autoUpdate": true,
  "go.installDependenciesWhenBuilding": true,
  // SNMP and MIB file support with golangci-lint integration
  "go.alternateTools": {
    "go": "go",
    "gofmt": "goimports",
    "golint": "golangci-lint"
  },
  // YAML specific settings (for Argus config files)
  "yaml.validate": true,
  "yaml.hover": true,
  "yaml.completion": true,
  "yaml.format.enable": true,
  "yaml.format.singleQuote": false,
  "yaml.format.bracketSpacing": true,
  "yaml.schemas": {
    "https://json.schemastore.org/chart.json": [
      "**/chart/Chart.yaml",
      "**/chart/Chart.yml"
    ],
    "https://json.schemastore.org/helmfile.json": [
      "**/chart/values.yaml",
      "**/chart/values.yml"
    ],
    "https://json.schemastore.org/golangci-lint.json": [
      ".golangci.yml",
      ".golangci.yaml",
      "golangci.yml",
      "golangci.yaml"
    ],
    "./schema.json": [
      "orion.yaml",
      "orion.yml",
      "configs/*.yaml",
      "configs/*.yml"
    ],
    "./values.schema.json": [
      "values.yaml",
      "values.yml"
    ]
  },
  // Git settings optimized for Argus development
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.ignoreLimitWarning": true,
  "git.detectSubmodules": false,
  // File associations for Argus project
  "files.associations": {
    "*.yaml": "yaml",
    "*.yml": "yaml",
    "*.go": "go",
    "go.mod": "go.mod",
    "go.sum": "go.sum",
    "go.work": "go.work",
    "Makefile": "makefile",
    "*.mk": "makefile",
    "Dockerfile": "dockerfile",
    "*.dockerfile": "dockerfile",
    "*.cue": "cue",
    "*.mib": "snmp-mib",
    "*.MIB": "snmp-mib",
    "test-*.yml": "yaml",
    "sample-*.yml": "yaml",
    "**/mibs/*": "snmp-mib",
    "**/templates/*.cue": "cue",
    "docker-compose*.yml": "dockercompose",
    ".golangci.yml": "yaml",
    ".golangci.yaml": "yaml",
    "golangci.yml": "yaml",
    "golangci.yaml": "yaml",
    // Helm template files
    "**/chart/templates/*.yaml": "helm",
    "**/chart/templates/*.yml": "helm",
    "**/chart/Chart.yaml": "yaml",
    "**/chart/values.yaml": "yaml",
    "**/chart/values.yml": "yaml",
    "**/chart/templates/NOTES.txt": "helm",
    "**/chart/templates/_helpers.tpl": "helm"
  },
  // Language specific settings for Argus project
  "[go]": {
    "editor.insertSpaces": false,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never",
      "source.fixAll": "explicit"
    },
    "editor.defaultFormatter": "golang.go",
    "editor.tabSize": 4,
    "editor.detectIndentation": false,
    "editor.semanticHighlighting.enabled": true,
    "editor.suggest.snippetsPreventQuickSuggestions": false
  },
  "[go.mod]": {
    "editor.defaultFormatter": "golang.go",
    "editor.tabSize": 4,
    "editor.insertSpaces": false,
    "editor.formatOnSave": true
  },
  "[go.sum]": {
    "editor.defaultFormatter": "golang.go",
    "editor.tabSize": 4,
    "editor.insertSpaces": false
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.autoIndent": "advanced",
    "editor.formatOnSave": true,
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    }
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.markdownlint": "explicit"
    },
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    },
    "editor.tabSize": 2
  },
  // Prettier configuration for markdown table formatting
  "prettier.proseWrap": "preserve",
  "prettier.printWidth": 120,
  "prettier.tabWidth": 2,
  "prettier.singleQuote": false,
  "prettier.trailingComma": "es5",
  // Markdownlint configuration (replaces .markdownlint.yml)
  "markdownlint.config": {
    "default": true,
    "MD009": {
      "br_spaces": 2,
      "list_item_empty_lines": false,
      "strict": true
    },
    "MD010": {
      "code_blocks": true,
      "spaces_per_tab": 2
    },
    "MD011": true,
    "MD012": {
      "maximum": 1
    },
    "MD013": false,
    "MD014": true,
    "MD018": true,
    "MD019": true,
    "MD020": true,
    "MD021": true,
    "MD022": true,
    "MD023": true,
    "MD024": {
      "siblings_only": true
    },
    "MD025": false,
    "MD026": {
      "punctuation": ".,;:!?"
    },
    "MD027": true,
    "MD028": true,
    "MD029": false,
    "MD030": {
      "ul_single": 1,
      "ol_single": 1,
      "ul_multi": 1,
      "ol_multi": 1
    },
    "MD031": true,
    "MD032": true,
    "MD033": {
      "allowed_elements": [
        "div",
        "span",
        "img",
        "a",
        "br",
        "code",
        "pre",
        "type",
        "ip-or-host",
        "name"
      ]
    },
    "MD034": true,
    "MD035": {
      "style": "---"
    },
    "MD036": false,
    "MD037": true,
    "MD038": true,
    "MD039": true,
    "MD040": true,
    "MD041": true,
    "MD042": true,
    "MD043": true,
    "MD044": false,
    "MD045": true,
    "MD046": {
      "style": "fenced"
    },
    "MD047": true,
    "MD048": {
      "style": "backtick"
    },
    "MD049": {
      "style": "underscore"
    },
    "MD050": {
      "style": "asterisk"
    },
    "MD051": false,
    "MD055": {
      "style": "consistent"
    }
  },
  "[makefile]": {
    "editor.insertSpaces": false,
    "editor.detectIndentation": false,
    "editor.tabSize": 4
  },
  "[dockerfile]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true
  },
  "[shellscript]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true
  },
  "[cue]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true
  },
  "[dockercompose]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true
  },
  "[helm]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true,
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.suggest.insertMode": "replace",
    "editor.wordBasedSuggestions": "off"
  },
  // Search settings optimized for Helm chart project
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/vendor": true,
    "**/bin": true,
    "**/dist": true,
    "**/build": true,
    "**/logs": true,
    "**/test-results": true,
    "**/.git": true,
    "**/*.log": true,
    "**/*.tmp": true,
    "**/*.bak": true,
    "**/coverage*.out": true,
    "**/.vscode": false,
    "**/chart/charts": true,
    "**/chart/*.tgz": true
  },
  // File watcher settings for performance
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/vendor/**": true,
    "**/bin/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/logs/**": true,
    "**/test-results/**": true,
    "**/*.log": true,
    "**/*.tmp": true,
    "**/*.bak": true,
    "**/coverage*.out": true,
    "**/chart/charts/**": true,
    "**/chart/*.tgz": true
  },
  // Helm-specific settings
  "helm-intellisense.customValueFileNames": [
    "values.yaml",
    "values.yml"
  ],
  // Terminal settings
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.env.linux": {
    "HELM_EXPERIMENTAL_OCI": "1",
    "KUBECONFIG": "${workspaceFolder}/.kube/config"
  },
  // Task runner integration
  "task.autoDetect": "on",
  // Problem matcher settings
  "problems.decorations.enabled": true,
  "problems.showCurrentInStatus": true,
  // IntelliSense settings
  "typescript.suggest.autoImports": false,
  "javascript.suggest.autoImports": false,
  // Helm chart workspace settings
  "workbench.colorCustomizations": {
    "statusBar.background": "#326ce5",
    "statusBar.foreground": "#ffffff",
    "statusBar.noFolderBackground": "#326ce5",
    "statusBarItem.hoverBackground": "#4285f4",
    "statusBar.debuggingBackground": "#ff5555",
    "statusBar.debuggingForeground": "#ffffff",
    "statusBarItem.prominentBackground": "#0f1419",
    "statusBarItem.prominentForeground": "#326ce5",
    "statusBarItem.prominentHoverBackground": "#1e2328"
  },
  // ShellCheck settings for shell script linting
  "shellcheck.enable": true,
  "shellcheck.enableQuickFix": true,
  "shellcheck.run": "onSave",
  "shellcheck.exclude": [],
  "shellcheck.customArgs": [],
  "shellcheck.ignorePatterns": {
    "**/*.csh": true,
    "**/*.cshrc": true,
    "**/*.fish": true,
    "**/*.login": true,
    "**/*.logout": true,
    "**/*.tcsh": true,
    "**/*.tcshrc": true,
    "**/*.xonshrc": true,
    "**/*.xsh": true,
    "**/*.zsh": true,
    "**/*.zshrc": true,
    "**/zshrc": true,
    "**/*.zprofile": true,
    "**/zprofile": true,
    "**/*.zlogin": true,
    "**/zlogin": true,
    "**/*.zlogout": true,
    "**/zlogout": true,
    "**/*.zshenv": true,
    "**/zshenv": true,
    "**/*.zsh-theme": true
  },
  // Breadcrumb settings
  "breadcrumbs.enabled": true,
  "breadcrumbs.showFiles": true,
  "cSpell.words": [
    "dagre",
    "morphism"
  ]
}
